[Unit]
Description=Bluetooth pairing agent for Irene (accepts pairing without PIN while discoverable)
After=bluetooth.service
Requires=bluetooth.service

[Service]
# адаптер появляется не сразу после старта bluetooth.service — даём ему время, ошибки не фатальны
ExecStartPre=/bin/sleep 3
ExecStartPre=-/usr/bin/bluetoothctl power on
ExecStartPre=-/usr/bin/bluetoothctl pairable on
ExecStart=/usr/bin/bt-agent --capability=NoInputNoOutput
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
