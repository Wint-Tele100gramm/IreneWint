[Unit]
Description=Snapcast client: Irene multiroom music on this box's speaker
After=irene-snapserver.service pipewire.service pipewire-pulse.service
Wants=irene-snapserver.service

[Service]
# ID "local" — комната приставки (local_room в runva_rooms.json). Звук — через ALSA default (PipeWire).
ExecStart=/usr/bin/snapclient --host 127.0.0.1 --hostID local --player alsa
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
