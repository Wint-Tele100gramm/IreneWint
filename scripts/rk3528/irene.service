[Unit]
Description=Irene voice assistant
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
# Сервер комнат: клиенты ESP32 + (если задан local_room в runva_rooms.json) микрофон самой приставки.
ExecStart=@REPO@/.venv/bin/python runva_rooms.py
RestartForceExitStatus=3
Restart=on-failure
RestartSec=2
# не даём Ирине съесть всю память приставки
MemoryHigh=900M
MemoryMax=1200M
Nice=-5

[Install]
WantedBy=default.target
