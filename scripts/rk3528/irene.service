[Unit]
Description=Ruslana voice assistant
After=pipewire.service pipewire-pulse.service wireplumber.service irene-snapserver.service
Wants=pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
# меньше «арен» malloc у многопоточных PyTorch и распознавания — заметно меньше занятой, но пустой памяти
Environment=MALLOC_ARENA_MAX=2
# Сервер комнат: клиенты ESP32 + (если задан local_room в options/rooms.json) микрофон самой приставки.
ExecStart=@REPO@/.venv/bin/python runva_rooms.py
RestartForceExitStatus=3
Restart=on-failure
RestartSec=2
# не даём Руслане съесть всю память приставки
MemoryHigh=900M
MemoryMax=1200M
Nice=-5

[Install]
WantedBy=default.target
